# Placement Referee — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Google Gemini API key — get yours at https://aistudio.google.com/
# Multi-key rotation pool supported (GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_1=your_backup_gemini_key_1
# GEMINI_API_KEY_2=your_backup_gemini_key_2

# Unstract LLMWhisperer API key — used to extract text from PDF/DOCX uploads (optional fallback available)
# Get your key at https://unstract.com/
UNSTRACT_API_KEY=your_unstract_api_key_here

# MongoDB connection string
# Local:  mongodb://localhost:27017/placement_referee
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/placement_referee
MONGODB_URI=mongodb://localhost:27017/placement_referee

# Server port — leave as 5000 for local dev
# On Render, PORT is injected automatically so you don't need to set it there
PORT=5000

# Allowed frontend origins (comma-separated, no trailing slash)
# Local:      http://localhost:5173
# Production: https://your-placement-referee.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Max resume upload size in MB
MAX_FILE_SIZE_MB=10

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
